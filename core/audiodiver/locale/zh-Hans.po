#: addition.py
msgid "Only a sound with takes the game picks from can have a new take"
msgstr "只有本身带变体、游戏会从中随机选取的声音，才能添加新变体"

#: addition.py
msgid "This sound has no take to copy"
msgstr "此声音没有可复制的变体"

#: addition.py
msgid "Only a sound with takes the game picks from can have a layer"
msgstr "只有本身带变体、游戏会从中随机选取的声音，才能添加层"

#: addition.py
msgid "This sound is one of the random choices of another sound, so a layer would only add another choice"
msgstr "此声音是另一个声音的随机选项之一，添加层只会多出一个选项"

#: addition.py
msgid "Nothing plays this sound directly, so a layer beside it would never play"
msgstr "没有任何对象直接播放此声音，因此与它并列的层永远不会播放"

#: addition.py
msgid "A new container ({id}) with {n} sound can't be a layer, because it has no sounds"
msgid_plural "A new container ({id}) with {n} sounds can't be a layer, because it has no sounds"
msgstr[0] "含 {n} 个声音的新容器（{id}）不能作为层，因为它没有声音"

#: addition.py
msgid "A new container ({id}) with {n} sound can't be a layer, because only a sound with takes the game picks from can have a layer"
msgid_plural "A new container ({id}) with {n} sounds can't be a layer, because only a sound with takes the game picks from can have a layer"
msgstr[0] "含 {n} 个声音的新容器（{id}）不能作为层，因为只有本身带变体、游戏会从中随机选取的声音才能添加层"

#: addition.py
msgid "A new container ({id}) with {n} sound can't be a layer, because this sound has no take to copy"
msgid_plural "A new container ({id}) with {n} sounds can't be a layer, because this sound has no take to copy"
msgstr[0] "含 {n} 个声音的新容器（{id}）不能作为层，因为此声音没有可复制的变体"

#: addition.py
msgid "bank {id}, which this version of the game doesn't have"
msgstr "音频库 {id}（当前游戏版本中没有）"

#: addition.py
msgid "A new container ({id}) with {n} sound can't be a layer, because this sound is one of the random choices of another sound, so a layer would only add another choice"
msgid_plural "A new container ({id}) with {n} sounds can't be a layer, because this sound is one of the random choices of another sound, so a layer would only add another choice"
msgstr[0] "含 {n} 个声音的新容器（{id}）不能作为层，因为此声音是另一个声音的随机选项之一，添加层只会多出一个选项"

#: addition.py
msgid "Container {id} has no take to copy"
msgstr "容器 {id} 没有可复制的变体"

#: addition.py
msgid "A new container ({id}) with {n} sound can't be a layer, because nothing plays this sound directly, so a layer beside it would never play"
msgid_plural "A new container ({id}) with {n} sounds can't be a layer, because nothing plays this sound directly, so a layer beside it would never play"
msgstr[0] "含 {n} 个声音的新容器（{id}）不能作为层，因为没有任何对象直接播放此声音，与它并列的层永远不会播放"

#: addition.py
msgid "A new container ({id}) with {n} sound can't be a layer, because Audiodiver can't tell which sound it plays with"
msgid_plural "A new container ({id}) with {n} sounds can't be a layer, because Audiodiver can't tell which sound it plays with"
msgstr[0] "含 {n} 个声音的新容器（{id}）不能作为层，因为 Audiodiver 无法判断它与哪个声音一起播放"

#: addition.py
msgid "Container {id} is one of the choices of a random container, so a layer beside it would only be another choice"
msgstr "容器 {id} 是某个随机容器的选项之一，与它并列的层只会成为另一个选项"

#: addition.py
msgid "Nothing plays container {id} straight from an event, so a layer beside it would never play"
msgstr "没有事件直接播放容器 {id}，因此与它并列的层永远不会播放"

#: addition.py
msgid "Sound {id} plays no clip"
msgstr "声音 {id} 不播放任何片段"

#: addition.py editor.py
msgid "Sound {id} isn't in this version of the game"
msgstr "声音 {id} 不在当前游戏版本中"

#: addition.py
msgid "Container {id} isn't in this version of the game"
msgstr "容器 {id} 不在当前游戏版本中"

#: addition.py
msgid "Layer {id} has no takes"
msgstr "层 {id} 没有变体"

#: addition.py
msgid "A new sound ({id}) has no audio in the patch"
msgstr "新声音（{id}）在补丁中没有音频"

#: addition.py
msgid "Sound {id} plays a clip that has no audio in the patch"
msgstr "声音 {id} 播放的片段在补丁中没有音频"

#: addition.py
msgid "A new sound ({id}) is in a place where Audiodiver can't add a take (under object {parent})"
msgstr "新声音（{id}）所在的位置（对象 {parent} 之下）无法添加变体"


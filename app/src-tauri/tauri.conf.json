{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audiodiver",
  "version": "1.0.0",
  "identifier": "com.audiodiver.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Audiodiver",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; media-src 'self' http://127.0.0.1:* blob:; img-src 'self' data: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://divershub.app"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2Q0ZFQTE3MzlGRDdDNUYKUldSZmZQMDVGK3JQQnNTZUs0aTM5YytqMjRuamprLzRnNGFiVXNTd09FZzR2ZHVJNEdWQU5vMzIK",
      "endpoints": ["https://github.com/Alomare/Audiodiver/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
